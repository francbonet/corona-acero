{
  "name": "corona-y-acero",
  "version": "0.9.0",
  "private": true,
  "type": "module",
  "description": "RTS de navegador ambientado en la Baja Edad Media, en pixel art isométrico",
  "author": "Corona y Acero",
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "torneo": "vitest run --config vitest.torneo.config.ts",
    "plantillas": "vitest run --config vitest.plantillas.config.ts",
    "itch": "npm run build && rm -f corona-y-acero-web.zip && cd dist && zip -qr ../corona-y-acero-web.zip .",
    "icono": "node scripts/icono.mjs",
    "escritorio": "npm run build && electron .",
    "escritorio:prueba": "electron . --smoke-test",
    "escritorio:mac": "npm run build && node scripts/escritorio.mjs mac",
    "escritorio:win": "npm run build && node scripts/escritorio.mjs win",
    "escritorio:linux": "npm run build && node scripts/escritorio.mjs linux"
  },
  "dependencies": {
    "@fontsource/pixelify-sans": "^5.3.0",
    "@fontsource/silkscreen": "^5.3.0",
    "pixi.js": "^8.23.0",
    "preact": "^11.2.0"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "electron": "^45.4.1",
    "electron-builder": "^26.18.0",
    "typescript": "^7.0.2",
    "vite": "^8.3.8",
    "vitest": "^5.1.1"
  },
  "build": {
    "appId": "com.coronayacero.juego",
    "productName": "Corona y Acero",
    "copyright": "Corona y Acero",
    "artifactName": "Corona-y-Acero-${version}-${os}-${arch}.${ext}",
    "directories": {
      "output": "release",
      "buildResources": "build"
    },
    "files": [
      "dist/**/*",
      "electron/**/*",
      "package.json"
    ],
    "mac": {
      "category": "public.app-category.strategy-games",
      "icon": "build/icon.png",
      "identity": null,
      "target": [
        {
          "target": "dmg",
          "arch": [
            "arm64",
            "x64"
          ]
        },
        {
          "target": "zip",
          "arch": [
            "arm64",
            "x64"
          ]
        }
      ]
    },
    "dmg": {
      "title": "${productName}"
    },
    "win": {
      "icon": "build/icon.png",
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "shortcutName": "Corona y Acero",
      "artifactName": "Corona-y-Acero-${version}-win-${arch}-instalador.${ext}"
    },
    "portable": {
      "artifactName": "Corona-y-Acero-${version}-win-${arch}-portable.${ext}"
    },
    "linux": {
      "icon": "build/icon.png",
      "category": "Game",
      "target": [
        {
          "target": "AppImage",
          "arch": [
            "x64"
          ]
        }
      ]
    }
  }
}
